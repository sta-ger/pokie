> pokie@1.3.0 generate-barrels
> node generate-barrels.js


> pokie@1.3.0 build-cjs
> npm run generate-barrels && tsc --project tsconfig.prod.json --module CommonJS --outDir dist/cjs && node write-cjs-package-json.js && shx cp src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs dist/cjs/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs


> pokie@1.3.0 generate-barrels
> node generate-barrels.js


> pokie@1.3.0 build-cli
> tsc --project tsconfig.cli.json && npm run build-client && npm run build-studio-client && shx chmod +x dist/cli/pokie.js


> pokie@1.3.0 build-client
> tsc --project tsconfig.client.json && shx cp cli/client/index.html cli/client/style.css dist/cli/client/



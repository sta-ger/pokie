> eslint . --ext .ts,.tsx


> pokie@1.3.0 build
> npm run generate-barrels && shx rm -rf ./dist && npm run build-esm && npm run build-cjs && npm run build-cli


> pokie@1.3.0 generate-barrels
> node generate-barrels.js



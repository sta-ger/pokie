{
    "name": "@fromstan/pokie",
    "version": "1.3.0",
    "description": "FromStan/POKIE: a video slot game logic framework for JavaScript and TypeScript.",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./client/player": {
            "import": {
                "types": "./dist/cli/client/player/index.d.ts",
                "default": "./dist/cli/client/player/index.js"
            }
        },
        "./browser": {
            "import": {
                "types": "./dist/esm/browser.d.ts",
                "default": "./dist/esm/browser.js"
            }
        },
        "./wasm": {
            "import": {
                "types": "./dist/esm/wasm/browser.d.ts",
                "default": "./dist/esm/wasm/browser.js"
            }
        }
    },
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "bin": {
        "pokie": "./dist/cli/pokie.js"
    },
    "scripts": {
        "generate-barrels": "node generate-barrels.js",
        "lint": "eslint . --ext .ts,.tsx",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && npm run typecheck-studio-client",
        "pretest": "npm run lint",
        "test": "mkdir -p \"$PWD/node_modules/.cache/pokie-tmp\" && TMPDIR=\"$PWD/node_modules/.cache/pokie-tmp\" NODE_OPTIONS=--experimental-vm-modules jest --selectProjects pokie pokie-examples studio-client-components --maxWorkers=\"${JEST_WORKERS:-2}\"",
        "test:integration": "jest --selectProjects pokie-integration --maxWorkers=2",
        "test:targeted": "mkdir -p \"$PWD/node_modules/.cache/pokie-tmp\" && TMPDIR=\"$PWD/node_modules/.cache/pokie-tmp\" NODE_OPTIONS=--experimental-vm-modules node --max-old-space-size=1408 ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath",
        "evidence:pc14-interoperability": "node scripts/generate-pc14-interoperability-evidence.mjs",
        "check:cli-inventory": "npm run build-cli && node scripts/check-cli-inventory.mjs --cli dist/cli/pokie.js --evidence-dir docs/audit-corrections/current-cli-inventory",
        "test:workflows": "node --max-old-space-size=512 scripts/run-studio-workflow-tests.mjs",
        "test:coverage": "node --max-old-space-size=512 ./node_modules/jest/bin/jest.js --selectProjects pokie pokie-examples studio-client-components pokie-integration studio-client-workflows --coverage --maxWorkers=1 --workerIdleMemoryLimit=192MB",
        "test:packaging": "jest --selectProjects pokie-packaging --runInBand",
        "test:report": "node scripts/report-test-timings.mjs",
        "bench": "node --expose-gc ./node_modules/jest/bin/jest.js --selectProjects pokie-benchmarks --runInBand",
        "check:fast": "npm test",
        "check:full": "node scripts/run-full-check.mjs",
        "check:release": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:packaging",
        "release:pc20": "node scripts/pc-20-release-completion.mjs",
        "build-esm:compile": "tsc --project tsconfig.prod.json && shx cp src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs dist/esm/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs && shx mkdir -p dist/esm/gamepackage/internal && shx cp src/gamepackage/internal/runtimeLocation.mjs dist/esm/gamepackage/internal/runtimeLocation.mjs",
        "build-cjs:compile": "tsc --project tsconfig.prod.json --module CommonJS --outDir dist/cjs && node write-cjs-package-json.js && shx cp src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs dist/cjs/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs && shx mkdir -p dist/cjs/gamepackage/internal && shx cp src/gamepackage/internal/runtimeLocation.mjs dist/cjs/gamepackage/internal/runtimeLocation.mjs",
        "build-esm": "npm run generate-barrels && npm run build-esm:compile",
        "build-cjs": "npm run generate-barrels && npm run build-cjs:compile",
        "build-test-runtime": "npm run generate-barrels && npm run build-esm:compile && npm run build-cjs:compile",
        "build-client": "tsc --project tsconfig.client.json && shx cp cli/client/index.html cli/client/style.css dist/cli/client/",
        "typecheck-studio-client": "tsc --project cli/studio-client/tsconfig.json --noEmit",
        "build-studio-client": "npm run typecheck-studio-client && vite build --config cli/studio-client/vite.config.ts && shx test -f dist/cli/studio-client/index.html",
        "audit:studio-polish": "node scripts/p8-04-studio-polish-browser-audit.mjs",
        "audit:product-readiness": "node scripts/p8-05-product-readiness-campaign.mjs",
        "audit:product-readiness:browser": "node scripts/p8-05-valera-browser-audit.mjs",
        "audit:product-readiness:campaign": "node scripts/p8-05-product-readiness-controller.mjs",
        "release:p8-05": "node scripts/p8-05-release-completion.mjs",
        "release:p8-05:gate": "node scripts/p8-05-release-completion.mjs --gate-only",
        "dev-studio-client": "npm run build-cli && node scripts/start-studio-client-dev.mjs",
        "build-cli:compile": "tsc --project tsconfig.cli.json && npm run build-client && npm run build-studio-client && shx chmod +x dist/cli/pokie.js",
        "build-cli": "npm run generate-barrels && npm run build-esm:compile && npm run build-cjs:compile && npm run build-cli:compile",
        "prebuild": "npm run lint",
        "build": "npm run generate-barrels && shx rm -rf ./dist && npm run build-esm:compile && npm run build-cjs:compile && npm run build-cli:compile",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fromstan/pokie.git"
    },
    "keywords": [
        "TypeScript",
        "JavaScript",
        "Casino",
        "Slot"
    ],
    "author": {
        "name": "sta-ger",
        "email": "pascaldelger@gmail.com",
        "url": "https://github.com/sta-ger"
    },
    "homepage": "https://pokie.fromstan.com",
    "license": "ISC",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "devDependencies": {
        "@mantine/core": "^9.4.1",
        "@mantine/form": "^9.4.1",
        "@mantine/hooks": "^9.4.1",
        "@mantine/modals": "^9.4.1",
        "@mantine/notifications": "^9.4.1",
        "@tabler/icons-react": "^3.44.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^29.5.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fs-extra": "^11.1.1",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.19",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^2.8.8",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1",
        "shx": "^0.3.4",
        "ts-jest": "^29.1.0",
        "typescript": "^5.0.4",
        "undici": "^8.7.0",
        "vite": "^8.1.5"
    },
    "files": [
        "dist/",
        "src/",
        "README.md",
        "LICENSE",
        "package.json",
        "docs/README.md",
        "docs/certification-evidence-bundle.md",
        "docs/cli.md",
        "docs/extension-points.md",
        "docs/external-adapter-sdk.md",
        "docs/free-games.md",
        "docs/game-packages.md",
        "docs/game-session.md",
        "docs/getting-started.md",
        "docs/math-modeling.md",
        "docs/outcome-library-bundle.md",
        "docs/paylines-and-patterns.md",
        "docs/paytable-and-wins.md",
        "docs/pregenerated-runtime.md",
        "docs/provably-fair.md",
        "docs/reel-strip-generation.md",
        "docs/reels-and-sequences.md",
        "docs/resizable-grid.md",
        "docs/round-artifacts.md",
        "docs/serialization.md",
        "docs/simulation.md",
        "docs/stake-engine-export.md",
        "docs/stake-engine-import.md",
        "docs/stake-engine-standalone.md",
        "docs/studio-frontend.md",
        "docs/studio-long-running-jobs.md",
        "docs/testing.md",
        "docs/wasm-compatibility-boundary.md",
        "docs/weighted-outcome-library.md",
        "docs/v2-completion/V2C-01.md",
        "docs/v2-completion/V2C-02.md",
        "docs/v2-completion/V2C-03.md",
        "docs/v2-completion/V2C-04.md",
        "docs/v2-completion/V2C-05.md",
        "docs/v2-completion/V2C-06.md",
        "docs/v2-completion/V2C-07.md",
        "docs/v2-completion/V2C-08.md",
        "docs/v2-completion/V2C-09.md",
        "docs/v2-completion/V2C-10.md",
        "docs/v2-completion/V2C-11.md",
        "docs/v2-completion/V2C-12.md",
        "docs/v2-completion/V2C-13.md",
        "docs/v2-completion/V2C-14.md",
        "docs/v2-completion/V2C-15.md",
        "docs/v2-completion/V2C-16.md",
        "docs/v2-completion/launch-mechanics-support.md",
        "docs/weighted-bonus.md",
        "examples/blueprints/bounded-*.blueprint.json",
        "examples/blueprints/weighted-bonus.blueprint.json",
        "examples/blueprints/wild-*.blueprint.json"
    ],
    "dependencies": {
        "commander": "^14.0.3",
        "exceljs": "^4.4.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://publication-disabled.invalid"
    }
}

{
    "name": "@fromstan/pokie",
    "version": "2.0.0",
    "description": "ISC-licensed game math, headless JavaScript/TypeScript runtime and local authoring tools.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./client/player": {
            "import": {
                "types": "./dist/cli/client/player/index.d.ts",
                "default": "./dist/cli/client/player/index.js"
            }
        },
        "./browser": {
            "import": {
                "types": "./dist/esm/browser.d.ts",
                "default": "./dist/esm/browser.js"
            }
        },
        "./wasm": {
            "import": {
                "types": "./dist/esm/wasm/browser.d.ts",
                "default": "./dist/esm/wasm/browser.js"
            }
        }
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "bin": {
        "pokie": "./dist/cli/pokie.js"
    },
    "scripts": {
        "generate-barrels": "node scripts/generate-barrels.mjs",
        "lint": "eslint \"**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && npm run typecheck-studio-client",
        "pretest": "npm run lint",
        "test": "mkdir -p \"$PWD/node_modules/.cache/pokie-tmp\" && TMPDIR=\"$PWD/node_modules/.cache/pokie-tmp\" NODE_OPTIONS=--experimental-vm-modules jest --selectProjects pokie pokie-examples --maxWorkers=\"${JEST_WORKERS:-2}\"",
        "test:integration": "jest --selectProjects pokie-integration --maxWorkers=2",
        "test:targeted": "mkdir -p \"$PWD/node_modules/.cache/pokie-tmp\" && TMPDIR=\"$PWD/node_modules/.cache/pokie-tmp\" NODE_OPTIONS=--experimental-vm-modules node --expose-gc --max-old-space-size=1408 scripts/run-targeted-tests.mjs",
        "test:coverage": "node --max-old-space-size=512 ./node_modules/jest/bin/jest.js --selectProjects pokie pokie-examples pokie-integration --coverage --maxWorkers=1 --workerIdleMemoryLimit=192MB",
        "test:packaging": "jest --selectProjects pokie-packaging --runInBand",
        "audit:prod": "npm audit --omit=dev",
        "test:report": "node scripts/report-test-timings.mjs",
        "check:fast": "npm test",
        "check:full": "node scripts/run-full-check.mjs",
        "check:release": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:packaging && npm run audit:prod",
        "build-esm:compile": "tsc --project tsconfig.prod.json && shx cp src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs dist/esm/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs && shx mkdir -p dist/esm/gamepackage/internal && shx cp src/gamepackage/internal/runtimeLocation.mjs dist/esm/gamepackage/internal/runtimeLocation.mjs",
        "build-esm": "npm run generate-barrels && npm run build-esm:compile",
        "build-test-runtime": "npm run generate-barrels && npm run build-esm:compile",
        "build-client": "tsc --project tsconfig.client.json && shx cp cli/client/index.html cli/client/style.css dist/cli/client/",
        "typecheck-studio-client": "tsc --project cli/studio-client/tsconfig.json --noEmit",
        "build-studio-client": "npm run typecheck-studio-client && vite build --config cli/studio-client/vite.config.ts && shx test -f dist/cli/studio-client/index.html",
        "dev-studio-client": "npm run build-cli && node scripts/start-studio-client-dev.mjs",
        "build-cli:compile": "tsc --project tsconfig.cli.json && shx mkdir -p dist/src/gamepackage/internal && shx cp src/gamepackage/internal/runtimeLocation.mjs dist/src/gamepackage/internal/runtimeLocation.mjs && shx cp src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs dist/src/simulation/parallel/internal/resolveDefaultWorkerEntryUrl.mjs && npm run build-client && npm run build-studio-client && shx chmod +x dist/cli/pokie.js",
        "build-cli": "npm run generate-barrels && npm run build-esm:compile && npm run build-cli:compile",
        "prebuild": "npm run lint",
        "build": "npm run generate-barrels && shx rm -rf ./dist && npm run build-esm:compile && npm run build-cli:compile",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sta-ger/pokie.git"
    },
    "keywords": [
        "TypeScript",
        "JavaScript",
        "Casino",
        "Slot"
    ],
    "author": {
        "name": "sta-ger",
        "email": "pascaldelger@gmail.com",
        "url": "https://github.com/sta-ger"
    },
    "homepage": "https://github.com/sta-ger/pokie",
    "license": "ISC",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@mantine/core": "^9.4.1",
        "@mantine/form": "^9.4.1",
        "@mantine/hooks": "^9.4.1",
        "@mantine/modals": "^9.4.1",
        "@mantine/notifications": "^9.4.1",
        "@tabler/icons-react": "^3.44.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.5.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "postcss": "^8.5.33",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^2.8.8",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.5",
        "shx": "^0.4.0",
        "ts-jest": "^29.4.15",
        "typescript": "^5.0.4",
        "undici": "^8.12.4",
        "vite": "^8.3.8"
    },
    "files": [
        "dist/",
        "src/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "package.json",
        "docs/",
        "examples/blueprints/",
        "templates/certification-dossier.v1.json"
    ],
    "dependencies": {
        "commander": "^14.0.3",
        "exceljs": "^4.4.0"
    },
    "overrides": {
        "exceljs": {
            "uuid": "npm:@lukeed/uuid@2.0.1",
            "fast-csv": "^5.0.8",
            "unzipper": "^0.12.5"
        },
        "jest-environment-jsdom": {
            "jsdom": "~27.4.0"
        },
        "test-exclude": "^8.0.0",
        "glob": "^14.0.6",
        "minimatch@>=7": "^11.0.9",
        "eslint-plugin-react": {
            "eslint": "$eslint"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
